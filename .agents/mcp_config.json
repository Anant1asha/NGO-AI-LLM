{
    "mcpServers": {
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "env": {
                "DISABLE_THOUGHT_LOGGING": "false"
            }
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "${CONTEXT7_API_KEY}"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest",
                "--isolated",
                "--headless"
            ]
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "C:/Users/admin/Downloads/NGO AI LLM",
                "C:/Users/admin/Downloads/NGO AI LLM/Aasha-AI",
                "C:/Users/admin/Downloads/NGO AI LLM/AASHA_Visual_Mass_Harvest_Phase3"
            ]
        }
    }
}
