{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/hachi/**",
              "ui_kits/cli/**",
              "ui_kits/tui/**",
              "ui_kits/webapp/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|navy)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HachiMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|style|key|ref|className|style|children)$/]",
        "message": "<HachiMark> doesn't accept that prop. Declared props: size, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HachiMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:two-tone|knockout)$/]",
        "message": "<HachiMark> variant must be one of 'two-tone' | 'knockout'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|mono|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeashPrompt'] > JSXAttribute > JSXIdentifier[name!=/^(?:request|action|why|onDeny|onAllowOnce|onAlwaysAllow|style|key|ref|className|style|children)$/]",
        "message": "<LeashPrompt> doesn't accept that prop. Declared props: request, action, why, onDeny, onAllowOnce, onAlwaysAllow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoyalLoop'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|speed|style|key|ref|className|style|children)$/]",
        "message": "<LoyalLoop> doesn't accept that prop. Declared props: size, color, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|status|progress|spent|budget|meta|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RunCard> doesn't accept that prop. Declared props: title, status, progress, spent, budget, meta, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:working|on-watch|done|blocked)$/]",
        "message": "<RunCard> status must be one of 'working' | 'on-watch' | 'done' | 'blocked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:working|on-watch|done|blocked)$/]",
        "message": "<StatusPill> status must be one of 'working' | 'on-watch' | 'done' | 'blocked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|key|ref|className|style|children)$/]",
        "message": "<TerminalLine> doesn't accept that prop. Declared props: text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|brand|working|success|danger)$/]",
        "message": "<TerminalLine> tone must be one of 'default' | 'muted' | 'brand' | 'working' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|tone|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|working|blocked)$/]",
        "message": "<Toast> tone must be one of 'success' | 'working' | 'blocked'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
