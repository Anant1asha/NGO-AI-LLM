# Keep the build context small + reproducible. README.md and src/ ARE needed.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Frontend is built from its own context (./frontend) — never ship its deps here.
frontend/node_modules
frontend/.output
frontend/.nitro
frontend/dist
frontend/.vinxi

# Local runtime/workspace data and dev artifacts.
.hachi
tests
*.log
.DS_Store
