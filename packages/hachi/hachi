#!/bin/bash
# Hachi CLI wrapper — delegates to the CLI installed in the project venv.
#
# Resolves both venv layouts so the same file works regardless of how the venv
# was created: POSIX puts the entry point in .venv/bin, Windows in .venv/Scripts.
# This previously hard-coded the Windows layout from a bash script, so on
# macOS/Linux it always failed with "No such file or directory", and the file
# was committed without the executable bit so it failed even earlier.
set -eu

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$here/.venv/bin/hachi" ]; then
    exec "$here/.venv/bin/hachi" "$@"
elif [ -f "$here/.venv/Scripts/hachi.exe" ]; then
    exec "$here/.venv/Scripts/hachi.exe" "$@"
else
    echo "hachi: no installed CLI found under $here/.venv" >&2
    echo "hachi: run 'uv sync' in $here first." >&2
    exit 1
fi
