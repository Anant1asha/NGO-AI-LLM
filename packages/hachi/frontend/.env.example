# ============================================================
# Hachi Web App — environment configuration
# Copy to `.env` (or `.env.local`) and adjust. All VITE_* vars are exposed to
# the browser; HACHI_GATEWAY_TOKEN is read only by the Vite dev proxy (node).
# ============================================================

# --- Dev proxy (recommended) -------------------------------------------------
# Leave VITE_HACHI_GATEWAY_URL unset to use the proxied "/api" base. Then the
# Vite dev server forwards /api/* to the gateway below and injects the bearer
# token, so the browser never sees the token and there is no CORS to configure.

# Where the Vite dev proxy forwards /api/* (the running gateway).
#   uv run hachi gateway --host 127.0.0.1 --port 8787 --runtime
HACHI_GATEWAY_PROXY_TARGET=http://127.0.0.1:8787

# Bearer token the dev proxy attaches to every forwarded request.
# Grab it from the gateway startup panel, or from the token file it prints,
# or run the gateway with HACHI_GATEWAY_NO_AUTH=1 and leave this blank.
HACHI_GATEWAY_TOKEN=

# --- Direct mode (prod / no proxy) ------------------------------------------
# Point the browser straight at a gateway origin. Requires the gateway's CORS
# allow-list to include this app's origin (HACHI_CORS_ORIGINS on the gateway).
# VITE_HACHI_GATEWAY_URL=http://127.0.0.1:8787
# VITE_HACHI_TOKEN=

# --- Mocks -------------------------------------------------------------------
# Force every wired domain to keep its seeded fixtures (offline UI work).
# Gap screens (Memory, OG, Authoring, Spend, real .og skill list) are mock
# regardless — they have no gateway endpoint yet.
VITE_HACHI_USE_MOCKS=false
