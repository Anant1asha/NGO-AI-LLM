{
  "name": "aasha-learning-ecosystem-root",
  "version": "1.0.0",
  "private": true,
  "description": "AASHA Learning & Impact Ecosystem — Unified Root Orchestrator",
  "scripts": {
    "audit:identity": "node scripts/audit_identity.mjs",
    "lint:superbrain": "node scripts/lint_superbrain_parity.mjs",
    "lint:superbrain:py": "python scripts/lint_superbrain_parity.py",
    "lint:secrets": "node scripts/lint_staged_secrets.mjs",
    "lint:workflows": "node scripts/lint_workflows.mjs",
    "memory:sync": "npx tsx scripts/aasha_memory_engine.ts",
    "memory:prime": "npx tsx scripts/jagiye_maakiran.ts",
    "gateway:ensure": "node scripts/ensure_9router.js",
    "gateway:start": "node scripts/ensure_9router.js",
    "graphify:build": "graphify build",
    "laya:default": "node scripts/set_laya_default.mjs",
    "laya:loop": "node scripts/aasha_continuous_loop.mjs --once",
    "laya:loop:audit": "node scripts/aasha_continuous_loop.mjs --audit-only",
    "laya:loop:frequent": "node scripts/aasha_continuous_loop.mjs --frequent",
    "laya:loop:hourly": "node scripts/aasha_continuous_loop.mjs --interval 60",
    "assets:orchestrate": "node scripts/orchestrate_local_cdn.mjs",
    "harvest:run": "node scripts/harvest_engine.mjs --run",
    "harvest:search": "node scripts/harvest_engine.mjs --search",
    "harvest:vendor": "node scripts/harvest_engine.mjs --vendor",
    "n8n:check": "node scripts/n8n_headless_client.mjs --check",
    "test:browser": "node scripts/verify_prestack_assets_browser.mjs",
    "aasha:build": "node scripts/aasha_build_runner.mjs",

    "start": "node scripts/aasha_root_orchestrator.js",
    "orchestrator": "node scripts/aasha_root_orchestrator.js",
    "studio": "npm --prefix aasha-studio run studio",
    "studio:ui": "npm --prefix aasha-studio/apps/studio-ui run dev",
    "studio:build": "npm --prefix aasha-studio run build",
    "studio:package": "npm --prefix aasha-studio/apps/desktop-tauri run build",
    "dev:learner": "npm --prefix Aasha-AI run dev:learner",
    "dev:api": "npm --prefix Aasha-AI run dev:api",
    "admin:status": "npm --prefix Aasha-AI run admin:status",
    "chapter:init": "npm --prefix Aasha-AI run chapter:init --",
    "test:ltruth": "npm --prefix Aasha-AI run validate",
    "test:master": "npm --prefix Aasha-AI run test:master",
    "test:concurrency": "cd Aasha-AI && npx tsx tests/test_concurrency_wiring.ts",
    "test:faults": "cd Aasha-AI && npx tsx tests/test_fault_injection_hardening.ts",
    "test:billing": "cd Aasha-AI && npx tsx tests/test_billing_observability_and_gemini_authorization.ts",
    "verify:sprint": "node scripts/verify_sprint_integrity.mjs",
    "verify:sprint:quick": "node scripts/verify_sprint_integrity.mjs --quick",
    "test:all": "npm --prefix Aasha-AI test && npm --prefix aasha-studio test && npm --prefix multi-agent-tui test",
    "tui": "npm --prefix multi-agent-tui run dev",
    "laya:test": "npm --prefix Aasha-AI exec -- tsx Aasha-AI/tests/laya_router.test.ts",
    "audit:gateway": "node scripts/check_gateway_status.js",
    "chapter:compile": "npm --prefix Aasha-AI run build:chapter",
    "chapter:bootstrap": "powershell -ExecutionPolicy Bypass -File Aasha-AI/aasha-pipeline-with-master-json/bootstrap.ps1",
    "chapter:pipeline": "powershell -ExecutionPolicy Bypass -File Aasha-AI/aasha-pipeline-with-master-json/run_pipeline.ps1",
    "chapter:pipeline:web": "powershell -ExecutionPolicy Bypass -File Aasha-AI/aasha-pipeline-with-master-json/run_pipeline.ps1 -Web",
    "chapter:test:unit": "cd Aasha-AI/aasha-pipeline-with-master-json && .\\.venv\\Scripts\\python.exe -m pytest tests/test_e2e_smoke.py::TestMinimalPdfCreation tests/test_e2e_smoke.py::TestHTMLAssemblerPlaceholders tests/test_e2e_smoke.py::TestQAAgentFallback tests/test_ingest_parallel.py -v",
    "chapter:test:offline": "cd Aasha-AI/aasha-pipeline-with-master-json && .\\.venv\\Scripts\\python.exe -m pytest tests/test_deep_vectorizer.py tests/test_offline_chapter_compilation.py -v",
    "chapter:test:integration": "cd Aasha-AI/aasha-pipeline-with-master-json && .\\.venv\\Scripts\\python.exe -m pytest tests/test_e2e_smoke.py::TestCLIImport -v",
    "chapter:test:e2e": "cd Aasha-AI/aasha-pipeline-with-master-json && .\\.venv\\Scripts\\python.exe -m pytest tests/test_e2e_smoke.py::TestFullE2EPipeline -v --timeout=600",
    "setup:rust": "powershell -ExecutionPolicy Bypass -File ./scripts/setup_rust_windows.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
