    "laya:default": "bash C:/Users/admin/.gemini/antigravity-ide/brain/7e576486-b3c6-4e3a-a202-07519c8394d7/set_laya_default_wrapper.sh",

    "start": "node scripts/aasha_root_orchestrator.js",
